{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.xml", "use": "@vercel/static" },
    {
      "src": "*.js",
      "use": "@vercel/static",
      "config": {
        "excludeFiles": "server.js"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server.js" },
    { "src": "/", "dest": "/index.html" },
    { "src": "/(.*\\.html)", "dest": "/$1" },
    { "src": "/(.*\\.png)", "dest": "/$1" },
    { "src": "/(.*\\.xml)", "dest": "/$1" },
    { "src": "/(.*\\.js)", "dest": "/$1" }
  ]
}
